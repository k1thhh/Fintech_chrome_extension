import sys
import os
sys.path.insert(0, os.path.dirname(__file__))

from core.registry import ToolRegistry
from core.agent import Agent
from tools.expenses import ExpenseStore, register_all as register_expenses
from tools.google_calendar import register_all as register_calendar


def build_agent() -> Agent:
    registry = ToolRegistry()

    print("\nLoading tools...")
    store = ExpenseStore()
    register_expenses(registry, store)
    register_calendar(registry)
    register_gpay(registry)
    print()

    return Agent(registry)


def main():
    agent = build_agent()
    print("ExpenseBot ready. Type 'quit' to exit.\n")

    while True:
        try:
            user_input = input("You: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nBot: Bye.")
            break

        if not user_input:
            continue
        if user_input.lower() in ("quit", "exit", "bye"):
            print("Bot: Bye.")
            break
        if user_input.lower() == "/reset":
            agent.reset()
            print("Bot: Conversation cleared.\n")
            continue

        reply = agent.chat(user_input)
        print(f"Bot: {reply}\n")


if __name__ == "__main__":
    main()
