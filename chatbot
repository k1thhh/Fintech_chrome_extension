import json
from typing import Any
from core.base_tool import BaseTool


class ToolRegistry:
    """
    Single source of truth for all tools.
    Add a new integration = instantiate it and call registry.register().
    The agent loop never needs to change.
    """

    def __init__(self):
        self._tools: dict[str, BaseTool] = {}

    def register(self, tool: BaseTool):
        self._tools[tool.name] = tool
        print(f"  ✓ registered tool: {tool.name}")

    def to_claude_specs(self) -> list[dict]:
        return [t.to_claude_spec() for t in self._tools.values()]

    def dispatch(self, tool_name: str, tool_input: dict) -> Any:
        tool = self._tools.get(tool_name)
        if not tool:
            return {"error": f"No tool named '{tool_name}' is registered."}
        try:
            result = tool.run(**tool_input)
            return result
        except TypeError as e:
            return {"error": f"Bad arguments for '{tool_name}': {e}"}
        except Exception as e:
            return {"error": f"Tool '{tool_name}' failed: {e}"}

    def dispatch_json(self, tool_name: str, tool_input: dict) -> str:
        return json.dumps(self.dispatch(tool_name, tool_input), default=str)

    //base_tool
    from abc import ABC, abstractmethod
from typing import Any

class BaseTool(ABC):
    """
    Every integration (expenses, calendar, gpay, etc.) is a BaseTool.
    Register it once. The agent discovers and calls it automatically.
    """

    @property
    @abstractmethod
    def name(self) -> str:
        """Unique snake_case name used by the LLM to call this tool."""
        ...

    @property
    @abstractmethod
    def description(self) -> str:
        """Plain-English description — this is what the LLM reads to decide when to call it."""
        ...

    @property
    @abstractmethod
    def parameters(self) -> dict:
        """JSON Schema for the tool's input parameters."""
        ...

    @abstractmethod
    def run(self, **kwargs) -> Any:
        """Execute the tool. Return a JSON-serialisable value."""
        ...

    def to_claude_spec(self) -> dict:
        """Converts this tool into the format Claude's API expects."""
        return {
            "name": self.name,
            "description": self.description,
            "input_schema": {
                "type": "object",
                **self.parameters
            }
        }
