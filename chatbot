import anthropic
from core.registry import ToolRegistry

SYSTEM = """You are a personal finance assistant. You are sharp, concise, and practical.

You help the user track expenses, manage their Google Calendar for finance-related events
(bill due dates, salary day, budget reviews), and will support payments in future.

Personality:
- Direct. No filler phrases like "Great question!" or "Certainly!"
- Use rupee symbol for all amounts.
- If you log an expense, confirm it in one line. Don't over-explain.
- If the user's message is ambiguous, ask one clarifying question — not three.
- Never expose internal tool names or JSON to the user.

You have tools. Use them. Chain them when it makes sense.
If a tool errors, tell the user plainly and suggest a fix.
"""


class Agent:
    def __init__(self, registry: ToolRegistry, model: str = "claude-sonnet-4-6"):
        self.registry = registry
        self.model = model
        self.client = anthropic.Anthropic()
        self.history: list[dict] = []

    def chat(self, user_message: str) -> str:
        self.history.append({"role": "user", "content": user_message})

        while True:
            response = self.client.messages.create(
                model=self.model,
                max_tokens=1024,
                system=SYSTEM,
                tools=self.registry.to_claude_specs(),
                messages=self.history
            )

            tool_uses  = [b for b in response.content if b.type == "tool_use"]
            text_blocks = [b for b in response.content if b.type == "text"]

            # No tool calls → final reply, exit loop
            if not tool_uses:
                self.history.append({"role": "assistant", "content": response.content})
                return " ".join(b.text for b in text_blocks).strip()

            # Append assistant turn (with tool_use blocks)
            self.history.append({"role": "assistant", "content": response.content})

            # Execute every tool Claude called, collect results
            results = []
            for tu in tool_uses:
                result_json = self.registry.dispatch_json(tu.name, tu.input)
                results.append({
                    "type": "tool_result",
                    "tool_use_id": tu.id,
                    "content": result_json
                })

            self.history.append({"role": "user", "content": results})
            # Loop continues → Claude sees results and decides next step

    def reset(self):
        self.history.clear()
