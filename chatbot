import datetime
import os
from core.base_tool import BaseTool

SCOPES = ["https://www.googleapis.com/auth/calendar"]
TOKEN_FILE  = "token.json"
CREDS_FILE  = "credentials.json"


def _get_service():
    """Handles OAuth2 flow and returns an authenticated Calendar service."""
    from google.oauth2.credentials import Credentials
    from google_auth_oauthlib.flow import InstalledAppFlow
    from google.auth.transport.requests import Request
    from googleapiclient.discovery import build

    creds = None
    if os.path.exists(TOKEN_FILE):
        creds = Credentials.from_authorized_user_file(TOKEN_FILE, SCOPES)
    if not creds or not creds.valid:
        if creds and creds.expired and creds.refresh_token:
            creds.refresh(Request())
        else:
            if not os.path.exists(CREDS_FILE):
                raise FileNotFoundError(
                    f"'{CREDS_FILE}' not found. Download it from Google Cloud Console."
                )
            flow = InstalledAppFlow.from_client_secrets_file(CREDS_FILE, SCOPES)
            creds = flow.run_local_server(port=0)
        with open(TOKEN_FILE, "w") as f:
            f.write(creds.to_json())
    return build("calendar", "v3", credentials=creds)


class ListCalendarEvents(BaseTool):
    name = "list_calendar_events"
    description = (
        "List upcoming Google Calendar events. Use for checking scheduled bills, "
        "salary dates, reminders, or any finance-related events."
    )
    parameters = {
        "properties": {
            "max_results": {
                "type": "integer",
                "description": "Max number of events to return (default 10)"
            },
            "query": {
                "type": "string",
                "description": "Optional text to search within events"
            }
        }
    }

    def run(self, max_results: int = 10, query: str | None = None):
        try:
            service = _get_service()
            now = datetime.datetime.utcnow().isoformat() + "Z"
            kwargs = {
                "calendarId": "primary",
                "timeMin": now,
                "maxResults": max_results,
                "singleEvents": True,
                "orderBy": "startTime"
            }
            if query:
                kwargs["q"] = query
            events = service.events().list(**kwargs).execute().get("items", [])
            return {
                "events": [
                    {
                        "id": e["id"],
                        "title": e.get("summary", "(no title)"),
                        "start": e["start"].get("dateTime", e["start"].get("date")),
                        "end":   e["end"].get("dateTime",   e["end"].get("date")),
                        "description": e.get("description", "")
                    }
                    for e in events
                ]
            }
        except Exception as e:
            return {"error": str(e)}


class CreateCalendarEvent(BaseTool):
    name = "create_calendar_event"
    description = (
        "Create a Google Calendar event. Use when the user wants to set a reminder "
        "for a bill due date, budget review, salary day, or any finance event."
    )
    parameters = {
        "properties": {
            "title":       {"type": "string", "description": "Event title"},
            "start":       {"type": "string", "description": "Start datetime ISO 8601, e.g. 2025-07-01T10:00:00"},
            "end":         {"type": "string", "description": "End datetime ISO 8601"},
            "description": {"type": "string", "description": "Optional event description"},
            "reminder_minutes": {
                "type": "integer",
                "description": "Minutes before event to send a reminder (default 30)"
            }
        },
        "required": ["title", "start", "end"]
    }

    def run(self, title: str, start: str, end: str,
            description: str = "", reminder_minutes: int = 30):
        try:
            service = _get_service()
            event = {
                "summary": title,
                "description": description,
                "start": {"dateTime": start, "timeZone": "Asia/Kolkata"},
                "end":   {"dateTime": end,   "timeZone": "Asia/Kolkata"},
                "reminders": {
                    "useDefault": False,
                    "overrides": [{"method": "popup", "minutes": reminder_minutes}]
                }
            }
            created = service.events().insert(calendarId="primary", body=event).execute()
            return {
                "created": {
                    "id":    created["id"],
                    "title": created.get("summary"),
                    "start": created["start"].get("dateTime"),
                    "link":  created.get("htmlLink")
                }
            }
        except Exception as e:
            return {"error": str(e)}


class DeleteCalendarEvent(BaseTool):
    name = "delete_calendar_event"
    description = "Delete a Google Calendar event by its ID."
    parameters = {
        "properties": {
            "event_id": {"type": "string", "description": "The event ID (from list_calendar_events)"}
        },
        "required": ["event_id"]
    }

    def run(self, event_id: str):
        try:
            service = _get_service()
            service.events().delete(calendarId="primary", eventId=event_id).execute()
            return {"deleted": event_id}
        except Exception as e:
            return {"error": str(e)}


def register_all(registry):
    for ToolClass in [ListCalendarEvents, CreateCalendarEvent, DeleteCalendarEvent]:
        registry.register(ToolClass())


