"""
Expense tracking tools.
Each operation is its own class — clean, testable, swappable.
All share a single ExpenseStore instance injected at startup.
"""

import datetime
import pandas as pd
from sklearn.linear_model import LinearRegression
from core.base_tool import BaseTool


class ExpenseStore:
    """Shared in-memory store. Swap this for SQLite/Postgres anytime."""
    def __init__(self):
        self.df = pd.DataFrame(columns=["date", "amount", "category"])
        self.limits: dict[str, float] = {}
        self.last: dict | None = None
        self._lr = LinearRegression()

    def add(self, amount: float, category: str):
        row = {"date": datetime.datetime.now(), "amount": amount, "category": category.lower()}
        self.df = pd.concat([self.df, pd.DataFrame([row])], ignore_index=True)
        self.last = row
        return row

    def total(self, category: str | None = None) -> float:
        df = self.df if not category else self.df[self.df["category"] == category.lower()]
        return round(df["amount"].sum(), 2)

    def summary(self) -> dict:
        if self.df.empty:
            return {}
        return self.df.groupby("category")["amount"].sum().round(2).to_dict()

    def history(self, category: str | None = None, limit: int = 5) -> list:
        if self.df.empty:
            return []
        df = self.df if not category else self.df[self.df["category"] == category.lower()]
        return df.sort_values("date", ascending=False).head(limit)[
            ["date", "amount", "category"]
        ].astype(str).to_dict(orient="records")

    def predict(self) -> float | None:
        if len(self.df) < 3:
            return None
        df = self.df.copy()
        df["day"] = pd.to_datetime(df["date"]).dt.dayofyear
        self._lr.fit(df[["day"]], df["amount"])
        next_day = datetime.datetime.now().timetuple().tm_yday + 1
        return round(self._lr.predict([[next_day]])[0], 2)

    def undo(self) -> dict | None:
        if not self.last:
            return None
        mask = (
            (self.df["date"] == self.last["date"]) &
            (self.df["amount"] == self.last["amount"]) &
            (self.df["category"] == self.last["category"])
        )
        self.df = self.df[~mask]
        undone, self.last = self.last, None
        return undone

    def clear(self, category: str | None = None) -> int:
        before = len(self.df)
        if category:
            self.df = self.df[self.df["category"] != category.lower()]
        else:
            self.df = pd.DataFrame(columns=["date", "amount", "category"])
            self.last = None
        return before - len(self.df)


# ── Individual tools ───────────────────────────────────────────────────────────

class AddExpense(BaseTool):
    name = "add_expense"
    description = "Log a new expense. Call this whenever the user mentions spending money."
    parameters = {
        "properties": {
            "amount":   {"type": "number",  "description": "Amount spent in INR"},
            "category": {"type": "string",  "description": "Category, e.g. food, transport, rent"}
        },
        "required": ["amount", "category"]
    }
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self, amount: float, category: str):
        row = self.store.add(amount, category)
        return {"logged": {"amount": amount, "category": category, "at": str(row["date"])}}


class GetTotal(BaseTool):
    name = "get_total"
    description = "Get total spending. Optionally filter by category."
    parameters = {
        "properties": {
            "category": {"type": "string", "description": "Category to filter by (optional)"}
        }
    }
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self, category: str | None = None):
        return {"total": self.store.total(category), "category": category or "all"}


class GetSummary(BaseTool):
    name = "get_summary"
    description = "Get a breakdown of spending by category."
    parameters = {"properties": {}}
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self):
        return {"summary": self.store.summary()}


class GetHistory(BaseTool):
    name = "get_history"
    description = "Get recent expense history, optionally filtered by category."
    parameters = {
        "properties": {
            "category": {"type": "string"},
            "limit":    {"type": "integer", "description": "Max entries to return (default 5)"}
        }
    }
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self, category: str | None = None, limit: int = 5):
        return {"history": self.store.history(category, limit)}


class SetLimit(BaseTool):
    name = "set_limit"
    description = "Set a monthly spending limit for a category."
    parameters = {
        "properties": {
            "category": {"type": "string"},
            "amount":   {"type": "number"}
        },
        "required": ["category", "amount"]
    }
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self, category: str, amount: float):
        self.store.limits[category.lower()] = amount
        return {"set": {"category": category, "limit": amount}}


class CheckLimits(BaseTool):
    name = "check_limits"
    description = "Check if any categories have exceeded their set limits."
    parameters = {"properties": {}}
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self):
        if not self.store.limits:
            return {"message": "No limits set."}
        return {"alerts": [
            {"category": cat, "total": self.store.total(cat), "limit": lim,
             "over": self.store.total(cat) > lim}
            for cat, lim in self.store.limits.items()
        ]}


class PredictExpense(BaseTool):
    name = "predict_next_expense"
    description = "Predict the next likely expense amount based on history."
    parameters = {"properties": {}}
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self):
        pred = self.store.predict()
        if pred is None:
            return {"error": "Need at least 3 expenses to predict."}
        return {"predicted_amount": pred}


class UndoExpense(BaseTool):
    name = "undo_last_expense"
    description = "Remove the most recently added expense."
    parameters = {"properties": {}}
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self):
        undone = self.store.undo()
        if not undone:
            return {"error": "Nothing to undo."}
        return {"undone": {"amount": undone["amount"], "category": undone["category"]}}


class ClearExpenses(BaseTool):
    name = "clear_expenses"
    description = "Delete expense data. Optionally clear only one category."
    parameters = {
        "properties": {
            "category": {"type": "string", "description": "Category to clear. Omit to clear everything."}
        }
    }
    def __init__(self, store: ExpenseStore): self.store = store
    def run(self, category: str | None = None):
        n = self.store.clear(category)
        return {"deleted": n, "scope": category or "all"}


def register_all(registry, store: ExpenseStore):
    for ToolClass in [AddExpense, GetTotal, GetSummary, GetHistory,
                      SetLimit, CheckLimits, PredictExpense, UndoExpense, ClearExpenses]:
        registry.register(ToolClass(store))
